# Copy to .env and replace every placeholder before starting.
DB_URL=jdbc:mysql://localhost:3306/quickbite
DB_USERNAME=quickbite
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
SERVER_PORT=8080
DELIVERY_FEE=2.50
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-generated-base64-256-bit-key
JWT_ACCESS_TOKEN_TTL_MS=900000
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
